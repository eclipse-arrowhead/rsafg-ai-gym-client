c\",\"address\":\"192.168.1.100\",\"port\":80,\"createdAt\":\"2025-05-28T17:32:55Z\",\"updatedAt\":\"2025-05-28T17:32:55Z\"},\"serviceUri\":\"/humidity\",\"secure\":\"NOT_SECURE\",\"version\":1,\"interfaces\":[{\"id\":2,\"interfaceName\":\"HTTP-INSECURE-JSON\",\"createdAt\":\"2025-05-28T09:25:24Z\",\"updatedAt\":\"2025-05-28T09:25:24Z\"}],\"createdAt\":\"2025-05-29T16:17:35Z\",\"updatedAt\":\"2025-05-29T16:17:35Z\"}\nResponse from Arrowhead Authorization Servcie \n\n{\"data\":[{\"id\":7,\"consumerSystem\":{\"id\":13,\"systemName\":\"zeppelinapi\",\"address\":\"192.168.1.100\",\"port\":7078,\"createdAt\":\"2025-05-28T19:47:57Z\",\"updatedAt\":\"2025-05-28T19:47:57Z\"},\"providerSystem\":{\"id\":11,\"systemName\":\"humiditymc\",\"address\":\"192.168.1.100\",\"port\":80,\"createdAt\":\"2025-05-28T17:32:55Z\",\"updatedAt\":\"2025-05-28T17:32:55Z\"},\"serviceDefinition\":{\"id\":34,\"serviceDefinition\":\"temperaturehumiditysrv\",\"createdAt\":\"2025-05-29T16:17:35Z\",\"updatedAt\":\"2025-05-29T16:17:35Z\"},\"interfaces\":[{\"id\":2,\"interfaceName\":\"HTTP-INSECURE-JSON\",\"createdAt\":\"2025-05-28T09:25:24Z\",\"updatedAt\":\"2025-05-28T09:25:24Z\"}],\"createdAt\":\"2025-05-29T16:17:35.386594961Z\",\"updatedAt\":\"2025-05-29T16:17:35.386594961Z\"}],\"count\":1}\nStep 4: subscribe to TemepratureHumidityEvent published by the Microcontroller \n\nService subscribd \n\n"
